# ==============================================================================
# Backend Configuration
# ==============================================================================
PROJECT_NAME="Yeswanth Portfolio API"
ENV=development
DEBUG=True
API_V1_STR=/api/v1

# CORS: Comma-separated list of origins or JSON list
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://yeswanth-portfolio.onrender.com"]

# Email Delivery Configuration (Resend API recommended for Render deployment)
EMAIL_SERVICE_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=ugginayeswanthnarasayyanaidu@gmail.com
EMAIL_FROM=Yeswanth Portfolio <onboarding@resend.dev>

# Optional SMTP Configuration (Alternative to Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=True

# PostgreSQL Database (SQLAlchemy 2.x synchronous connection string)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/<db_name>

# ==============================================================================
# Frontend Configuration (Vite)
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_PUBLIC_SITE_URL=https://your-production-domain.com
